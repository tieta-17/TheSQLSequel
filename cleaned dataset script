import pandas as pd

df = pd.read_csv('TMDB_movie_dataset_25k_samples.csv')

print(df.shape)
print(df.columns.tolist())
df.head(3)

# Step 1: Drop the useless columns
df = df.drop(columns=['Unnamed: 0', 'backdrop_path', 'homepage', 'poster_path'])

# Step 2: Rename id column and make sure it's an integer
df = df.rename(columns={'id': 'movie_id'})
df['movie_id'] = df['movie_id'].astype(int)

# Step 3: Replace 0 with None in budget and revenue (0 means unknown, not actually zero)
df['budget'] = df['budget'].replace(0, None)
df['revenue'] = df['revenue'].replace(0, None)

# Step 4: Replace 0 with None in runtime, drop rows where runtime is over 600
df['runtime'] = df['runtime'].replace(0, None)
df = df[df['runtime'].isna() | (df['runtime'] <= 600)]

# Step 5: Convert adult column from True/False string to 1/0
df['adult'] = df['adult'].map({True: 1, False: 0, 'True': 1, 'False': 0})

# Step 6: Clean up status column
df['status'] = df['status'].str.strip().str.title()

# Step 7: Parse release_date as a date
df['release_date'] = pd.to_datetime(df['release_date'], errors='coerce')

# Step 8: Check the result
print(df.shape)
df.head(3)

df.to_csv('TMDB_cleaned.csv', index=False)
